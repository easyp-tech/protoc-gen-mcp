/// Business handlers for every MCP primitive in internal/testproto/example/v1/example.proto.
struct ExampleMCPHandlers: Sendable {
    var exampleAPI: any ExampleAPIToolHandler
}

/// Builds the server declared by internal/testproto/example/v1/example.proto and registers its primitives.
/// Start it with serve(_:transport:) so MCP Apps is advertised when enabled.
func newExampleMCPServer(_ handlers: ExampleMCPHandlers) async throws -> Server {
    let server = try newConfiguredServer(name: "example.proto", version: "v0.0.1", apps: true)
    try await registerExampleAPITools(server, handlers.exampleAPI)
    return server
}

