    int last = 0;
    while (matcher.find()) {
      pattern.append(java.util.regex.Pattern.quote(uriTemplate.substring(last, matcher.start())));
      pattern.append("([^/]+)");
      last = matcher.end();
    }
    pattern.append(java.util.regex.Pattern.quote(uriTemplate.substring(last)));
    return java.util.regex.Pattern.compile(pattern.toString());
  }

